# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# claude code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ローカル専用の引き継ぎメモ(個人的な運用情報を含むため公開しない)
HANDOFF.local.md

# エクスポートした会話ログ(個人的なやり取りを含むため公開しない)
conversation-*.txt
conversation-*.md
